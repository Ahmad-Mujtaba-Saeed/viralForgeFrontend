# Backend API URL
#
# MUST be https. This value is baked into the static export at build time, and
# Netlify serves the site over HTTPS — a plain http:// value here makes every
# API call fail with "blocked:mixed-content" before the request is even sent.
NEXT_PUBLIC_BACKEND_URL=https://ahmad-mujtaba.site
# Local dev against the docker stack:
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8086
NODE_ENV=production

# Pusher Configuration (for real-time updates)
NEXT_PUBLIC_PUSHER_APP_KEY=5282de9a144de163a094
NEXT_PUBLIC_PUSHER_APP_CLUSTER=ap2
# Public origin of the marketing site. Baked into the static export at build
# time and used for every canonical URL, the sitemap, and the absolute
# OG/Twitter image URLs. MUST be the real production origin, with no trailing
# slash — a wrong value here makes every canonical point at the wrong site.
NEXT_PUBLIC_SITE_URL=https://vreato.com
